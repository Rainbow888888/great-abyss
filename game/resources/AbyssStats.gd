extends Resource
class_name AbyssStats

## Сколько объектов-материалов заполняет Бездну целиком.
@export var capacity: int = 60

## T0013 — всасывание. Высота кучи (в осколках), при которой из Бездны
## вылезает тёмный с пылесосом. Куча треугольная, поэтому осколков в ней
## примерно `порог² / 2`: порог 20 — это около 200 осколков.
@export var reclaim_threshold: int = 20

## Сколько осколков Бездна крадёт за тик на каждую колонку сверх порога.
@export var reclaim_per_excess: float = 0.5

## Как часто Бездна тянет. Секунды.
@export var reclaim_interval: float = 1.0

## T0021 — пробуждение. Сколько нужно засыпать, чтобы Бездна перешла
## в следующую стадию. После этого осколки Монолита перестают её
## двигать: мелкое ей больше не интересно, нужен источник крупнее.
@export var stage_threshold: int = 40

## Сколько засыпки даёт один блок разобранного Дома.
@export var house_block_value: int = 5

## T0018+T0019 — Дыхание Бездны. Волна идёт из зева по поверхности и
## сбивает носильщиков: кара летит в узкое место, как каламити в
## Dwarf Eats Mountain (`docs/05_References/DesignReferences.md`).
## Поднято с 20 после счёта T0026: при оглушении в 20 секунд и волне
## каждые 20 секунд носильщик лежит практически всегда — это не налог,
## а остановка игры. Пол интервала держим выше оглушения.
@export var wave_base_interval: float = 45.0

## Ниже этого интервал не опускается, как бы жадно ни засыпали.
@export var wave_floor_interval: float = 25.0

## Насколько чаще Бездна огрызается за каждую единицу засыпки,
## положенную с прошлой волны. Засыпаешь жаднее — бьёт чаще.
@export var wave_greed: float = 0.08

## Скорость расхождения волны, пикселей в секунду.
@export var wave_speed: float = 420.0

## Замах: сколько секунд Бездна видимо набирает воздух перед волной.
## В это время клик в любом месте пригибает всё племя разом (ADR-005).
@export var tell_duration: float = 1.5

## Сколько работы стоит пригибание. Одинаково для всех уровней
## стойкости — иначе вернулись бы скрытые секунды.
@export var duck_duration: float = 1.0

## Сколько секунд сбитый носильщик стоит оглушённый.
@export var stun_duration: float = 1.6
