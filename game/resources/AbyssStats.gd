extends Resource
class_name AbyssStats

## Сколько объектов-материалов заполняет Бездну целиком.
@export var capacity: int = 60

## T0013 — всасывание. Высота кучи (в осколках), при которой из Бездны
## вылезает тёмный с пылесосом. Куча треугольная, поэтому осколков в ней
## примерно `порог² / 2`: порог 20 — это около 200 осколков.
@export var reclaim_threshold: int = 20

## Сколько осколков Бездна крадёт за тик на каждую колонку сверх порога.
@export var reclaim_per_excess: float = 0.5

## Как часто Бездна тянет. Секунды.
@export var reclaim_interval: float = 1.0
